[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

# Runtime dependencies are defined once in pyproject.toml; the editable self-install
# below makes pipenv resolve them from there. Add/bump runtime deps in pyproject.toml,
# then run `make lock`.
[packages]
vra-fantasy = {path = ".", editable = true}

[dev-packages]
pytest = "*"
ruff = "*"

[scripts]
standings = "fantasy-standings"
game-id = "fantasy-game-id"
test = "pytest"
lint = "ruff check ."
format = "ruff format ."

[requires]
python_version = "3.13"
